{
  "expo": {
    "name": "FragileGuard",
    "slug": "fragileguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fragile-icon.png",
    "scheme": "fragileguard",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.student.fragileguard",
      "infoPlist": {
        "NSMotionUsageDescription": "FragileGuard uses motion sensors to detect parcel tilt, rotation, and impacts during a monitoring session."
      }
    },
    "android": {
      "package": "com.student.fragileguard",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#67B39B",
        "foregroundImage": "./assets/fragile-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/fragile-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8E9A1",
          "image": "./assets/fragile-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
